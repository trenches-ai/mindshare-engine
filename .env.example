TWITTER_BEARER_TOKEN=your_bearer_token_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindshare
WINDOW_MINUTES=5
MAX_QUERIES_PER_WINDOW=300
MIN_AUTHORS_FOR_BIRTH=3
LOG_LEVEL=INFO
LOG_FILE=logs/mindshare.log
EMBEDDING_MODEL=all-MiniLM-L6-v2
CLUSTER_SIMILARITY_THRESHOLD=0.75
BIRTH_DENSITY_THRESHOLD=0.6

# --- Virality scoring ---
VIRALITY_WINDOW_LOOKBACK=6
VIRALITY_SIGNAL_THRESHOLD=0.55
VIRALITY_ALERT_THRESHOLD=0.75

# --- Bot webhook (Telegram, Discord, or custom) ---
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
BOT_COOLDOWN_MINUTES=15
BOT_MAX_SIGNALS_PER_WINDOW=10
