# === Mindshare Engine v2.1 ===
# Copy to .env and fill in your values.
# On Railway: set these as service variables in the dashboard.
# DATABASE_URL is auto-injected by Railway's Postgres plugin — do NOT set it manually there.

TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAB8g7wEAAAAAav06r6D4rAb8ziridQko3xrUaY8%3Dbnr2XX8e5cqlq5AX12SNfKWBIzZTNhvuWxr7P0q0ztfo2K4OCG
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindshare

WINDOW_MINUTES=5
MAX_QUERIES_PER_WINDOW=300
MIN_AUTHORS_FOR_BIRTH=3
LOG_LEVEL=INFO
LOG_FILE=logs/mindshare.log
EMBEDDING_MODEL=all-MiniLM-L6-v2
CLUSTER_SIMILARITY_THRESHOLD=0.75
BIRTH_DENSITY_THRESHOLD=0.6

# --- Virality scoring ---
VIRALITY_WINDOW_LOOKBACK=6
VIRALITY_SIGNAL_THRESHOLD=0.55
VIRALITY_ALERT_THRESHOLD=0.75

# --- Bot webhook (Telegram, Discord, or custom) ---
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
BOT_COOLDOWN_MINUTES=15
BOT_MAX_SIGNALS_PER_WINDOW=8

# --- Discord webhook alerts ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1474111291076378839/M6-FuFOQOafDvAT_QhBnpY5dcBpLQ5bwmWFs3jGWhojv5N55BpWoMAZuaUbpH0-OGB7N
DISCORD_BOT_NAME=Mindshare Engine
DISCORD_BOT_AVATAR_URL=
DISCORD_ALERT_HIGH_CONVICTION=true
DISCORD_ALERT_MODERATE=false
DISCORD_POST_SUMMARY=true

# --- Railway deployment ---
# On Railway, leave LOG_FILE empty (logs go to stdout, Railway captures them):
#   LOG_FILE=
# DATABASE_URL is auto-set by Railway Postgres plugin.
